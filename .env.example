# Sandbox (padrão): https://api-sandbox.asaas.com/v3
# Produção (dados/pagamentos reais):  https://api.asaas.com/v3
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# A chave do Asaas começa com "$". Escape esse caractere com "\$", senão o
# carregador de .env do wrangler tenta expandi-lo como variável e a chave
# chega vazia no processo (você verá "integração com o Asaas não configurada").
# Ao trocar para a chave de produção, troque também ASAAS_BASE_URL acima —
# usar a chave de produção contra a URL do sandbox (ou vice-versa) falha.
ASAAS_API_KEY=\$cole_a_chave_do_sandbox_aqui

# Token que valida o header "asaas-access-token" enviado pelo Asaas em cada
# webhook (app/api/webhooks/asaas/route.ts). Gere um valor aleatório de 32+
# caracteres e cadastre o MESMO valor no painel do Asaas em
# Configurações > Integrações > Webhooks, junto com a URL pública dessa rota.
ASAAS_WEBHOOK_TOKEN=cole_um_token_aleatorio_de_32_ou_mais_caracteres

# Nenhuma variável de ambiente é necessária para o Tally (candidaturas do
# Chat Jurídico Connect) — a chave de API pessoal (Tally > Configurações da
# conta > API) e o identificador do formulário são cadastrados pela própria
# aba Integrações do painel, por conta.

SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Use a chave "service_role" (Project Settings > API), NUNCA a "anon"/"publishable".
# A chave fica somente no servidor, para autenticação, configuração e webhooks.
# Operações financeiras da sessão usam o JWT do usuário e respeitam o RLS.
# As variáveis Asaas e Sheets acima atendem apenas à base legada;
# novos usuários configuram suas próprias chaves na aba Integrações.
SUPABASE_SERVICE_ROLE_KEY=cole_a_service_role_key_aqui

# Gate de criação de clientes: um novo cliente só é criado a partir de um
# pagamento do Asaas se o e-mail dele já constar na aba "Base de Clientes"
# da planilha do Google Sheets. Como a planilha é privada e a organização
# bloqueia a criação de chaves de conta de serviço, a leitura é feita por um
# webhook do n8n (workflow "FIN-SisFin-Otavio": Webhook > Get row(s) in
# sheet > Respond to Webhook) que já usa uma credencial OAuth2 com acesso à
# planilha. Se CLIENTS_SHEET_WEBHOOK_URL ficar vazio, o filtro é desativado
# e todo cliente novo é aceito normalmente.
CLIENTS_SHEET_WEBHOOK_URL=https://flowhook.chatjuridico.com/webhook/base-clientes
# Valor enviado no header "sisfin-auth" configurado no node Webhook do n8n.
CLIENTS_SHEET_WEBHOOK_AUTH=cole_o_valor_do_header_sisfin-auth_aqui

# Proteção das chaves individuais (32 bytes aleatórios em hexadecimal). Nunca altere sem recriptografar as chaves salvas.
INTEGRATIONS_ENCRYPTION_KEY=
